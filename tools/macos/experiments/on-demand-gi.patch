+RID GI::_get_gi_pipeline(uint32_t p_specialization, Mode p_mode) {
+	RID &pipeline = pipelines[p_specialization][p_mode];
+	if (pipeline.is_null()) {
+		// Constant IDs 0, 1 and 2 are the corresponding bits in ShaderSpecializations.
+		Vector<RD::PipelineSpecializationConstant> constants;
+		for (uint32_t id = 0; id < 3; id++) {
+			RD::PipelineSpecializationConstant sc;
+			sc.type = RD::PIPELINE_SPECIALIZATION_CONSTANT_TYPE_BOOL;
+			sc.constant_id = id;
+			sc.bool_value = (p_specialization & (1u << id)) != 0;
+			constants.push_back(sc);
+		}
+		const int variant_base = RendererSceneRenderRD::get_singleton()->is_vrs_supported() ? MODE_MAX : 0;
+		pipeline = RD::get_singleton()->compute_pipeline_create(shader.version_get_shader(shader_version, variant_base + p_mode), constants);
+	}
+	return pipeline;
+}
