+// Timing-only macOS template. Each interval runs on the caller's thread.
+#pragma once
+#include <os/signpost.h>
+#include <atomic>
+#include <cstdio>
+#include <time.h>
+
+class LTOStartupInterval {
+	static os_log_t log() {
+		static os_log_t instance = os_log_create("org.godotengine.godot.metal", "startup-stages");
+		return instance;
+	}
+
+	os_signpost_id_t id;
+
+public:
+	explicit LTOStartupInterval(const char *label) {
+		id = os_signpost_id_generate(log());
+		os_signpost_interval_begin(log(), id, "startup_stage", "stage=%{public}s", label);
+	}
+
+	void finish() {
+		if (id != OS_SIGNPOST_ID_INVALID) {
+			os_signpost_interval_end(log(), id, "startup_stage");
+			id = OS_SIGNPOST_ID_INVALID;
+		}
+	}
+
+	~LTOStartupInterval() { finish(); }
+};
+
+// A launch can encode thousands of uploads on one thread in a few milliseconds.
+// Count these locally so streaming signpost pairs cannot overrun the observer.
+class LTOUploadTimer {
+	static inline std::atomic<uint64_t> calls{0}, total{0}, longest{0};
+	uint64_t begin = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+
+public:
+	~LTOUploadTimer() {
+		uint64_t elapsed = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW) - begin;
+		calls.fetch_add(1, std::memory_order_relaxed);
+		total.fetch_add(elapsed, std::memory_order_relaxed);
+		uint64_t previous = longest.load(std::memory_order_relaxed);
+		while (previous < elapsed && !longest.compare_exchange_weak(previous, elapsed, std::memory_order_relaxed)) {
+		}
+	}
+
+	static void report() {
+		std::fprintf(stderr, "[startup-stages] uploads %llu total_ns %llu longest_ns %llu\n",
+				(unsigned long long)calls.load(), (unsigned long long)total.load(), (unsigned long long)longest.load());
+	}
+};
